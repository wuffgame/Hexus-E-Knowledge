// ============================================
    HEXUS MEGA-DEMO
    Program demonstrujący niemal wszystkie
    funkcje jezyka Hexus (E-Knowledge).
    Autor: Claude, na podstawie docs.hexus-lang.dev
============================================ //

# --- 1. Zmienne, typy danych i komentarze ---
app_name = "Hexus Mega-Demo"
version is "1.0"
is_running = True
pi_value = 3.14159

send "=== {app_name} v{version} ==="
send "Start programu: {now}"

# --- 2. Send / Read ---
send "Witaj w programie demonstracyjnym!" to console
read "Podaj swoje imie: " to player_name
send "Czesc, {player_name}!"

# --- 3. Inkrementacja / dekrementacja ---
score = 0
score++
score += 49
send "Wynik startowy: {score}"

lives = 5
lives--
send "Zyc pozostalo: {lives}"

# --- 4. Operatory porownania i logiczne ---
age = 21
has_permission = True

if age >= 18 and has_permission is True {
    send "Dostep przyznany."
} elif (age >= 13) or (not has_permission) {
    send "Dostep czesciowy."
} else {
    send "Brak dostepu."
}

if player_name is not "" {
    send "Nazwa gracza ustawiona poprawnie."
}

# --- 5. Modulo ---
test_number = 17
if test_number % 2 == 0 {
    send "{test_number} jest parzyste"
} else {
    send "{test_number} jest nieparzyste"
}

# --- 6. Petla while + break/continue ---
counter = 0
while counter < 10 {
    counter++
    if counter % 2 == 0 {
        continue
    }
    if counter == 9 {
        send "Koniec petli while (break)."
        break
    }
    send "Nieparzysty licznik: {counter}"
}

# --- 7. Petla repeat ---
send "Odliczanie startu:"
repeat 3 times {
    send "Beep!"
}
send "Start!"

# --- 8. Funkcje wlasne ---
func calculate_total(price, tax_rate) {
    total = price + (price * tax_rate)
    return total
}

func greet_player(name) {
    send "----------------------------------"
    send "Witaj ponownie, {name}!"
    send "----------------------------------"
}

greet_player(player_name)
final_price = calculate_total(100, 0.23)
send "Cena koncowa z podatkiem: {final_price}"

# --- 9. Listy: add, remove, length of, pos of ---
inventory = "miecz", "tarcza",
add "eliksir" to inventory
add "helm" to inventory at pos 1
send inventory

items_count = length of inventory
send "Liczba przedmiotow: {items_count}"

first_item = pos 1 of inventory
send "Pierwszy przedmiot: {first_item}"

remove "tarcza" from inventory
remove pos 1 from inventory
send inventory

# --- 10. For-each ---
scores = 10, 20, 30, 40,
total_score = 0
for each s in scores {
    total_score += s
}
send "Suma wynikow: {total_score}"

# --- 11. Petla numeryczna for + zagniezdzenie ---
for row from 1 to 3 {
    for col from 1 to 3 {
        send "{row} * {col} = {row * col}"
    }
}

# --- 12. Losowanie liczb ---
dice_roll = get random number from 1 to 6
send "Rzut kostka: {dice_roll}"

if get random number from 1 to 10 > 5 {
    send "Szczescie Ci sprzyja!"
} else {
    send "Tym razem pech."
}

# --- 13. Make lower / upper ---
shout = "hexus is awesome"
make shout upper
send shout

whisper = "HELLO WORLD"
make shout lower
send whisper

# --- 14. Unarny minus/plus ---
temperature = -5
celsius = 25
fahrenheit_negative = -(celsius * 9 / 5 + 32)
send "Odwrocona temperatura: {fahrenheit_negative}"
positive_value = +42
send "Wartosc dodatnia: {positive_value}"

# --- 15. Timer ---
timer start
slow_counter = 0
repeat 1000 times {
    slow_counter = slow_counter + 1
}
timer stop
elapsed = timer
send "Obliczenia zajely: {elapsed} sekund."

# --- 16. Modul Time ---
send "Godzina: {time.hour}:{time.minute}:{time.second}"
send "Data: {time.day}/{time.month}/{time.year}"

full_time = time.get time "%Y-%m-%d %H:%M:%S"
send "Pelny format: {full_time}"

send "UTC+2: {time.get time UTC+2}"

# --- 17. Modul File ---
file.open "demo_log.txt" as logfile
file.write "Log rozpoczety: {now}" to logfile
file.append "\nGracz: {player_name}, wynik: {score}" to logfile
file.append "\nEkwipunek: {inventory}" to logfile
file.close logfile

file.open "demo_log.txt" as logfile
file.read logfile into log_content
send "Zawartosc logu:\n{log_content}"
file.close logfile

# --- 18. Wait + clear screen ---
send "Konczenie programu za chwile..."
wait 1 s
clear screen
send "Ekran wyczyszczony. Dziekujemy za uruchomienie demo!"

# --- 19. Stop z komunikatem ---
if score < 0 {
    stop "Blad krytyczny: ujemny wynik!"
}

send "Program zakonczony pomyslnie o {now}."
stop "Do zobaczenia nastepnym razem!"
